# Copie este arquivo para android/local.properties e ajuste os caminhos locais.
# Linux/macOS:
# sdk.dir=/caminho/para/Android/Sdk
# flutter.sdk=/caminho/para/flutter
# Windows use barras duplas ou barras normais, por exemplo:
# sdk.dir=C:/Android/Sdk
# flutter.sdk=C:/src/flutter
flutter.buildMode=debug
flutter.versionName=1.3.0
flutter.versionCode=1
